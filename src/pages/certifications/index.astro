---
import Layout from "../../layouts/Layout.astro";
import { certifications } from "../../data/profile";
---

<Layout
  title="Certifications"
  description="Certifications held by Minh Nguyen, ordered by relevance to banking and payments engineering."
>
  <div class="wrap-narrow">
    <div class="page-head">
      <h1>Certifications</h1>
      <p class="lede">
        Ordered by how much they actually bear on banking and payments work, not
        alphabetically and not by recency.
      </p>
    </div>

    <div class="card-grid">
      {
        certifications.map((cert) => (
          <article class="card">
            <h3>{cert.name}</h3>
            <p>{cert.issuer}</p>
            {cert.relevance && <p class="card-foot">{cert.relevance}</p>}
          </article>
        ))
      }
    </div>
  </div>
</Layout>
