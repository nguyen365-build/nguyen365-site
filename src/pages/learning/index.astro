---
import Layout from "../../layouts/Layout.astro";

// Deliberately kept separate from the case studies. These are practice
// projects; presenting them as production work would undercut the pages that
// actually are.
const exercises = [
  {
    name: "Game Hub",
    learned: "React and TypeScript end to end - routing, state, and API consumption.",
  },
  {
    name: "Movie Rental",
    learned: "Relational data modelling and CRUD fundamentals on a fresh stack.",
  },
  {
    name: "Azure AI Translator",
    learned: "Wiring an Azure Cognitive Services integration, including key handling.",
  },
];
---

<Layout
  title="Learning Exercises"
  description="Practice projects, kept deliberately separate from the production case studies."
>
  <div class="wrap-narrow">
    <div class="page-head">
      <h1>Learning exercises</h1>
      <p class="lede">
        These are practice projects, not production work, and they're on a separate
        page for exactly that reason. They're here because how someone picks up an
        unfamiliar stack is worth showing - not because they're the strongest thing
        on this site. That's the <a href="/case-studies/">case studies</a>.
      </p>
    </div>

    <div class="card-grid">
      {
        exercises.map((ex) => (
          <article class="card">
            <h3>{ex.name}</h3>
            <p>{ex.learned}</p>
          </article>
        ))
      }
    </div>
  </div>
</Layout>
